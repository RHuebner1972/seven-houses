# Copy to .env.local for local dev. All NEXT_PUBLIC_* values are inlined at build time.

# Origin of the API deployment (Vercel project with root `api/`), no trailing slash. Default: http://localhost:8000
NEXT_PUBLIC_API_URL=https://seventh-house-api.vercel.app

# RevenueCat Web Billing public API key (the `rcb_...` key for the web app). Unset: billing falls back to mock.
NEXT_PUBLIC_RC_WEB_KEY=

# Google OAuth 2.0 web client id for the sign-in button. Unset: only the magic link works.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Billing backend: `mock` or `revenuecat`. Unset: `revenuecat` when NEXT_PUBLIC_RC_WEB_KEY is set, else `mock`.
NEXT_PUBLIC_BILLING=mock
